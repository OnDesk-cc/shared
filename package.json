{
  "name": "@ondesk/shared",
  "version": "1.19.0",
  "private": true,
  "type": "module",
  "description": "Code shared by every OnDesk product (console, Pulse, Vault, Orbit, Nexus, Halo). Raw TypeScript — the consuming app's bundler compiles it.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OnDesk-cc/shared.git"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc -p tsconfig.ui.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "docs": "node scripts/gen-docs.mjs",
    "docs:check": "node scripts/gen-docs.mjs --check",
    "docs:gaps": "node scripts/gen-docs.mjs --gaps",
    "test": "tsx --test \"worker/**/*.test.ts\" \"components/**/*.test.ts\""
  },
  "peerDependencies": {
    "@ai-sdk/react": "^4.0.0",
    "@cloudflare/ai-chat": "^0.12.1",
    "@tanstack/react-query": "^5.90.21",
    "agents": ">=0.26.0 <1.0.0",
    "ai": "^7.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.575.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@ai-sdk/react": "^4.0.133",
    "@cloudflare/ai-chat": "^0.12.1",
    "@cloudflare/workers-types": "4.20260302.0",
    "@tanstack/react-query": "^5.90.21",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "agents": "^0.26.0",
    "ai": "^7.0.130",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.575.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
