{
  // Worker half: worker/ only. Mirrors each app's tsconfig.functions.json. Kept as a
  // separate program because @cloudflare/workers-types and the DOM lib disagree on
  // the same global names.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["worker", "i18n/locale.ts", "i18n/format.ts", "i18n/dictionary.ts", "i18n/index.ts"],
  // Las pruebas (node:test vía tsx) usan tipos de Node: fuera del typecheck.
  "exclude": ["**/*.test.ts"]
}
